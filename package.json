    "type": "git",
    "url": "git+https://github.com/asturksever/istanbul-methane.git"
  },
  "keywords": [
    "methane",
    "carbon-mapper",
    "landfill",
    "istanbul",
    "cop31",
    "cesiumjs",
    "3d-tiles",
    "volumetric-rendering",
    "climate"
  ],
  "author": "Said Turksever",
  "scripts": {
    "start": "cd web && python3 -m http.server 8000",
